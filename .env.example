# Địa chỉ trang quản trị (phone-store-manager) — trang này lấy dữ liệu qua API công khai /api/public/*
# Local: http://localhost:3002 · Production: https://<domain trang quản trị>
ADMIN_API_URL="http://localhost:3002"

# Domain chính thức (cho sitemap / robots), vd https://taikhoamobile.vn — để trống thì dùng domain Vercel
SITE_URL=""

# Thông tin hiển thị trên trang
SHOP_NAME="Tài Khoa Mobile"
# Hotline / Zalo — để trống thì dùng hotline cơ sở chính trong src/lib/stores.ts
SHOP_PHONE=""
SHOP_ZALO=""
# Mạng xã hội (hiện ở footer + khối "Ghé cửa hàng"); để trống thì ẩn
SHOP_FACEBOOK="https://facebook.com/..."
SHOP_TIKTOK="https://www.tiktok.com/@..."
